rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default admin email check or admin document check
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'retrokronik@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Products Collection (Public Read, Admin Write)
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      // Bir siparişi doğrudan belge ID'siyle (get) okuma:
      // - sahibi kendi siparişini görebilir,
      // - admin her siparişi görebilir,
      // - misafir (userId: 'guest_user') siparişleri, ödeme sonrası onay/durum
      //   sayfası için ID bilinerek tek tek okunabilir.
      allow get: if isOwner(resource.data.userId) || isAdmin() || resource.data.userId == 'guest_user';

      // Toplu listeleme (query/onSnapshot(collection...)): yalnızca admin panelinde
      // tüm siparişleri, ya da giriş yapmış bir müşteri kendi userId'sine göre
      // filtrelenmiş bir sorgu ile (where('userId','==', kendi uid'si)) çekebilir.
      // Bu sayede "Sipariş Geçmişim" artık sadece o kullanıcının siparişlerini döner.
      allow list: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);

      // Sipariş oluşturma: yalnızca kendi adına - giriş yapmışsa kendi uid'siyle,
      // yapmamışsa 'guest_user' ile - sipariş açılabilir. Başkası adına
      // (başka bir userId ile) sahte sipariş oluşturulamaz.
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
                       (!isSignedIn() && request.resource.data.userId == 'guest_user');

      // Durum güncelleme / silme yalnızca admin.
      allow update, delete: if isAdmin();
    }

    // Store Settings Collection
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
